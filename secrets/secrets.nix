let
  server-mads = "";

  desktop-mads = "";

  wsl = "";
in
{
  # Wireguard
  "android-mads-wireguard-shared-secret.age".publicKeys = [ server-mads ];
  "android-mads-wireguard-public-key.age".publicKeys = [ server-mads ];

  "server-mads-wireguard-private-key.age".publicKeys = [ server-mads ];
  "server-mads-wireguard-public-key.age".publicKeys = [
    server-mads
    desktop-mads
    wsl
  ];

  # htpasswd
  "htpasswd.age".publicKeys = [ server-mads ];

  # sendmail
  "sendmail-password.age".publicKeys = [ server-mads ];
}
